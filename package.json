{
  "name": "ancient-city",
  "version": "0.1.0",
  "private": true,
  "description": "Ancient City - Phaser 3 + TypeScript ile gelistirilen 2D mobil strateji oyunu",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "node bench/fps.mjs",
    "bench:input": "node bench/input.mjs",
    "bench:smoke": "node bench/smoke.mjs"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.2",
    "eslint": "^9.39.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
